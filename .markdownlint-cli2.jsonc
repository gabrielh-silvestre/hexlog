{
  // Globais: linha longa e as regras que outros .md também violam por formato. As sete regras de
  // `overrides` valem para todo .md, menos o AGENTS.md gerado e os ADRs aceitos (imutáveis).
  "config": {
    "default": true,
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD032": false,
    "MD034": false,
    "MD038": false,
    "MD060": false,
  },
  "overrides": [
    {
      "filter": ["**/AGENTS.md", "docs/directives/adr-*.md"],
      "combine": "merge",
      "config": {
        "MD005": false,
        "MD007": false,
        "MD022": false,
        "MD029": false,
        "MD033": false,
        "MD056": false,
        "MD058": false,
      },
    },
  ],
  "gitignore": true,
  "ignores": ["docs/pesquisa/**", ".github/pull_request_template.md"],
}
