{
  "name": "hexlog",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.18.1"
  },
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[tj]s$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "allowJs": true,
            "esModuleInterop": true,
            "isolatedModules": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!canonicalize/)"
    ],
    "moduleNameMapper": {
      "^canonicalize$": "<rootDir>/node_modules/canonicalize/lib/canonicalize.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.0.0",
    "es-toolkit": "1.52.0",
    "jsonc-parser": "3.3.1",
    "minisearch": "7.2.0",
    "shell-quote": "1.10.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.8.1",
    "@types/shell-quote": "1.7.5",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.1",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.7",
    "ts-jest": "29.4.12",
    "typescript": "5.9.2",
    "typescript-eslint": "8.70.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
