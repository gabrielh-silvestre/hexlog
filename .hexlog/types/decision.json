{
  "type": "object",
  "properties": {
    "choice": { "type": "string", "minLength": 1, "maxLength": 300 },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "option": { "type": "string", "minLength": 1, "maxLength": 200 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "required": ["option", "reason"],
        "additionalProperties": false
      }
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "grounds": { "type": "string", "enum": ["directive", "gap"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
  },
  "required": ["choice", "alternatives", "rationale", "grounds", "confidence"],
  "additionalProperties": false
}
