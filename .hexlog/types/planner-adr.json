{
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^hex:target:[^\\s:]+$"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxItems": 5
    },
    "drivers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "maxItems": 5
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "pros": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "cons": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          }
        },
        "required": ["name", "pros", "cons"],
        "additionalProperties": false
      },
      "maxItems": 6
    },
    "chosen": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "why": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "attachment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": ["target", "iteration", "source", "chosen", "why", "attachment"],
  "additionalProperties": false
}
