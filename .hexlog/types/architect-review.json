{
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^hex:target:[^\\s:]+$"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "antithesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 350
      },
      "minItems": 1,
      "maxItems": 5
    },
    "synthesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "verdict": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "attachment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "target",
    "iteration",
    "source",
    "antithesis",
    "tradeoffs",
    "synthesis",
    "verdict",
    "attachment"
  ],
  "additionalProperties": false
}
