{
  "type": "object",
  "properties": {
    "result": { "type": "string", "enum": ["passed", "failed"] },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$", "maxLength": 40 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 200 },
          "ok": { "type": "boolean" },
          "summary": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "required": ["command", "ok"],
        "additionalProperties": false
      }
    }
  },
  "required": ["result", "commit", "commands"],
  "additionalProperties": false
}
