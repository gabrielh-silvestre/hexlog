{
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^hex:target:[^\\s:]+$"
    },
    "iteration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "verdict": {
      "type": "string",
      "enum": ["reject", "revise", "accept-with-reservations", "accept"]
    },
    "justification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "major", "minor"]
          },
          "finding": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          },
          "whyItMatters": {
            "type": "string",
            "minLength": 1,
            "maxLength": 220
          }
        },
        "required": ["severity", "finding", "whyItMatters"],
        "additionalProperties": false
      },
      "maxItems": 12
    },
    "attachment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "target",
    "iteration",
    "source",
    "verdict",
    "justification",
    "findings",
    "attachment"
  ],
  "additionalProperties": false
}
