{
  "type": "object",
  "properties": {
    "target": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^hex:target:[^\\s:]+$"
    },
    "iteration": {
      "type": "integer",
      "minimum": 2,
      "maximum": 20
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "changed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "change": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "motivatedBy": {
            "type": "object",
            "properties": {
              "finding": {
                "type": "string",
                "minLength": 1,
                "maxLength": 250
              },
              "event": {
                "type": "string",
                "maxLength": 260,
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}:[a-z0-9][a-z0-9-]{0,62}:[a-z0-9][a-z0-9-]{0,62}:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            },
            "required": ["finding"],
            "additionalProperties": false
          }
        },
        "required": ["change", "motivatedBy"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 260,
        "pattern": "^[a-z0-9][a-z0-9-]{0,62}:[a-z0-9][a-z0-9-]{0,62}:[a-z0-9][a-z0-9-]{0,62}:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "minItems": 1,
      "maxItems": 4
    },
    "attachment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": ["target", "iteration", "source", "changed", "supersedes"],
  "additionalProperties": false
}
