{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,pt-BR",
  "import": ["@cspell/dict-pt-br/cspell-ext.json"],
  "ignorePaths": [
    "docs/pesquisa/**",
    "node_modules/**",
    "package-lock.json",
    "dist/**",
    "coverage/**"
  ],
  "useGitignore": true,
  "words": [
    "abac",
    "actionlint",
    "autofixável",
    "bidi",
    "booleano",
    "builda",
    "buildado",
    "claude",
    "codacy",
    "decisionlog",
    "deduplica",
    "deduplicado",
    "deduplicados",
    "drvfs",
    "dumpable",
    "enospc",
    "escopado",
    "formulaico",
    "frontmatter",
    "fsyncgate",
    "ghas",
    "hardlink",
    "hasheia",
    "hasheiam",
    "hexlog",
    "hexlog's",
    "hextelemetry",
    "hotspots",
    "lintada",
    "memoizada",
    "memoizado",
    "metaschema",
    "mocka",
    "muta",
    "mutar",
    "opengrep",
    "parseador",
    "parsear",
    "parseia",
    "pesquisável",
    "pyproject",
    "qlty",
    "qube",
    "ralph",
    "ralplan",
    "rdsc",
    "reancoragem",
    "reconfere",
    "reconferida",
    "reconferir",
    "reconfira",
    "reconstruível",
    "refixa",
    "relista",
    "repina",
    "retentativa",
    "retentável",
    "sarif",
    "semgrep",
    "serialização",
    "spawna",
    "spawnada",
    "spawnado",
    "stdlib",
    "streamable",
    "subcaminhos",
    "subschema",
    "subschemas",
    "supersedeu",
    "tokeniza",
    "tokenizador",
    "tokenizar",
    "tokenização",
    "worktrees",
    "zizmor"
  ],
  "ignoreRegExpList": [
    "/`[^`\\n]+`/g",
    "/```[\\s\\S]*?```/g",
    "/\\]\\([^)\\s]*\\)/g",
    "/[\\w./-]+\\.md/g"
  ]
}
